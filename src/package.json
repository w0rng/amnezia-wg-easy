{
  "release": {
    "version": "14"
  },
  "name": "wg-easy",
  "version": "1.0.1",
  "type": "module",
  "description": "The easiest way to run WireGuard VPN + Web-based Admin UI.",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx tsc && npx tsc-alias -p tsconfig.json -f -fe .js",
    "start": "node dist/server.js",
    "prestart": "npm run build",
    "serve": "DEBUG=Server,WireGuard npx nodemon server.ts",
    "serve-with-password": "PASSWORD=wg npm run serve",
    "lint": "eslint -c eslintrc.json .",
    "buildcss": "npx tailwindcss -i ./www/src/css/app.css -o ./www/css/app.css"
  },
  "author": "Emile Nijssen",
  "license": "CC BY-NC-SA 4.0",
  "dependencies": {
    "basic-auth": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "crc-32": "^1.2.2",
    "debug": "^4.3.7",
    "dotenv": "^17.2.1",
    "express-session": "^1.18.0",
    "h3": "^1.11.1",
    "listhen": "^1.9.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@types/basic-auth": "^1.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/debug": "^4.1.12",
    "@types/dotenv": "^6.1.1",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "eslint-config-athom": "^3.1.3",
    "i": "^0.3.7",
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.10",
    "tsc-alias": "^1.8.16",
    "commander": "^4.1.1",
    "get-tsconfig": "^4.10.1",
    "mylas": "^2.1.13",
    "plimit-lit": "^1.6.1",
    "resolve-pkg-maps": "^1.0.0",
    "queue-lit": "^1.5.2"
  },
  "nodemonConfig": {
    "ignore": [
      "www/*"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
